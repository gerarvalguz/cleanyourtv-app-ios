        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviando el estilo a la TV."
          }
        }
      }
    },
    "Sending the name to the TV.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviando el nombre a la TV."
          }
        }
      }
    },
    "Service switched on": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicio activado"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes"
          }
        }
      }
    },
    "Some checks are incomplete": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas verificaciones están incompletas"
          }
        }
      }
    },
    "Spotlight": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Destacado"
          }
        }
      }
    },
    "Stopped. %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo. %@"
          }
        }
      }
    },
    "Stopped. %@ Nothing else was changed; you can try again or remove it.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo. %@ No se cambió nada más; puedes intentarlo de nuevo o quitarlo."
          }
        }
      }
    },
    "Stopped. %@ The previous order is saved on this iPhone.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo. %@ El orden anterior está guardado en este iPhone."
          }
        }
      }
    },
    "Stopped. %@ The previous settings are saved on this iPhone.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo. %@ Los ajustes anteriores están guardados en este iPhone."
          }
        }
      }
    },
    "Switches the service off and uninstalls the launcher and the service. Amazon's home screen is untouched.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva el servicio y desinstala el launcher y el servicio. La pantalla de inicio de Amazon no se toca."
          }
        }
      }
    },
    "TV IPv4 address": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección IPv4 de la TV"
          }
        }
      }
    },
    "TV identified. Review the safety report before applying package changes.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "TV identificada. Revisa el informe de seguridad antes de aplicar cambios a los paquetes."
          }
        }
      }
    },
    "TV input services": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicios de entrada de la TV"
          }
        }
      }
    },
    "Tap to request a secure ADB connection": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para solicitar una conexión ADB segura"
          }
        }
      }
    },
    "That package is not part of this review plan.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese paquete no forma parte de este plan de revisión."
          }
        }
      }
    },
    "That photo could not be used. Try another one.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo usar esa foto. Prueba con otra."
          }
        }
      }
    },
    "The TV already has a picture and keeps it. Choose a photo to replace it.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV ya tiene una imagen y la conserva. Elige una foto para reemplazarla."
          }
        }
      }
    },
    "The TV did not provide the serial number, device name and Android API needed to identify it.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV no proporcionó el número de serie, el nombre del dispositivo ni la API de Android necesarios para identificarla."
          }
        }
      }
    },
    "The TV did not respond in time.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV no respondió a tiempo."
          }
        }
      }
    },
    "The TV has a look tuned by hand. Pick one below to replace its look settings.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV tiene un estilo ajustado a mano. Elige uno abajo para reemplazar sus ajustes de estilo."
          }
        }
      }
    },
    "The TV rejected this ADB key. Check the TV's debugging authorization.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV rechazó esta clave ADB. Revisa la autorización de depuración en la TV."
          }
        }
      }
    },
    "The TV safety snapshot is incomplete or invalid.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura de seguridad de la TV está incompleta o no es válida."
          }
        }
      }
    },
    "The TV sent an invalid ADB response: %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV envió una respuesta ADB no válida: %@"
          }
        }
      }
    },
    "The app will compare each package with its saved state and only re-enable or re-disable it when needed.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La app comparará cada paquete con su estado guardado y solo lo reactivará o lo desactivará cuando sea necesario."
          }
        }
      }
    },
    "The bundled %@ file does not match its pinned digest.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo %@ incluido no coincide con su huella fijada."
          }
        }
      }
    },
    "The bundled %@ file is missing from the app.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el archivo %@ incluido en la app."
          }
        }
      }
    },
    "The bundled TV profile catalog has an invalid size.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El catálogo de perfiles de TV incluido tiene un tamaño no válido."
          }
        }
      }
    },
    "The bundled TV profile catalog is invalid.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El catálogo de perfiles de TV incluido no es válido."
          }
        }
      }
    },
    "The bundled TV profile catalog is missing.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el catálogo de perfiles de TV incluido."
          }
        }
      }
    },
    "The greeting at the top of the launcher says your name after it. Leave it empty and only the greeting shows.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El saludo en la parte superior del launcher dice tu nombre después. Si lo dejas vacío, solo se muestra el saludo."
          }
        }
      }
    },
    "The launcher restarts to show it. The previous order stays saved on this iPhone so you can put it back.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El launcher se reinicia para mostrarlo. El orden anterior queda guardado en este iPhone para que puedas restaurarlo."
          }
        }
      }
    },
    "The launcher restarts. A copy of the TV's current settings stays on this iPhone.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El launcher se reinicia. Una copia de los ajustes actuales de la TV queda en este iPhone."
          }
        }
      }
    },
    "The photo is cropped to 16:9 and shrunk on this iPhone; its place and camera details are not sent.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto se recorta a 16:9 y se reduce en este iPhone; no se envían el lugar ni los datos de la cámara."
          }
        }
      }
    },
    "The previous order is back.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El orden anterior fue restaurado."
          }
        }
      }
    },
    "The previous settings are back.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes anteriores fueron restaurados."
          }
        }
      }
    },
    "The saved review plan failed its integrity check.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan de revisión guardado no pasó la verificación de integridad."
          }
        }
      }
    },
    "This TV does not support the shell protocol required by Clean Your TV.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta TV no admite el protocolo de shell que requiere Clean Your TV."
          }
        }
      }
    },
    "This TV requires Android Wireless Debugging pairing, which is not supported yet.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta TV requiere la vinculación de Depuración inalámbrica de Android, que aún no es compatible."
          }
        }
      }
    },
    "This applies to Fire TV only; other TVs can take a launcher as their home screen directly.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto aplica solo a Fire TV; en otras TV se puede usar un launcher directamente como pantalla de inicio."
          }
        }
      }
    },
    "This draft is based on an older TV snapshot. Analyze the TV and create a new draft.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este borrador se basa en una captura anterior de la TV. Analiza la TV y crea un borrador nuevo."
          }
        }
      }
    },
    "This plan failed its integrity check. Create a new plan.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plan no pasó la verificación de integridad. Crea un plan nuevo."
          }
        }
      }
    },
    "This plan is out of date. Replace it with the latest analysis.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plan está desactualizado. Reemplázalo con el análisis más reciente."
          }
        }
      }
    },
    "This profile has no installed packages available for a review plan.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil no tiene paquetes instalados disponibles para un plan de revisión."
          }
        }
      }
    },
    "This saved plan is read-only because it does not match the latest TV scan. Analyze the TV and replace the plan to edit it.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plan guardado es de solo lectura porque no coincide con el último análisis de la TV. Analiza la TV y reemplaza el plan para editarlo."
          }
        }
      }
    },
    "To stop featured videos from autoplaying, use the TV remote: Settings > Preferences > Featured Content, then turn off video and audio autoplay. Sponsored rows may still appear. These home-screen controls are not available from the iPhone app.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detener la reproducción automática de los videos destacados, usa el control remoto de la TV: Ajustes > Preferencias > Contenido destacado y desactiva la reproducción automática de video y audio. Aún pueden aparecer filas patrocinadas. Estos controles de la pantalla de inicio no están disponibles desde la app del iPhone."
          }
        }
      }
    },
    "Turn on network debugging on the TV, then choose it below.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la depuración de red en la TV y luego elígela abajo."
          }
        }
      }
    },
    "View package names": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver nombres de paquetes"
          }
        }
      }
    },
    "Wait for package restoration to finish.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la restauración de los paquetes."
          }
        }
      }
    },
    "Wait for the current operation to finish.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la operación actual."
          }
        }
      }
    },
    "When the TV asks whether to allow USB/network debugging, choose Allow. Compare this fingerprint with the one shown by the TV if available.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la TV pregunte si permites la depuración USB/de red, elige Permitir. Compara esta huella con la que muestra la TV, si está disponible."
          }
        }
      }
    },
    "Wi-Fi": {},
    "Working on the TV.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajando en la TV."
          }
        }
      }
    },
    "Your TV's launcher stays an Android app. This iPhone app is its remote companion.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El launcher de tu TV sigue siendo una app de Android. Esta app del iPhone es su compañera de control remoto."
          }
        }
      }
    },
    "Your iPhone and TV need the same Wi-Fi.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPhone y tu TV deben estar en la misma red Wi-Fi."
          }
        }
      }
    },
    "Your iPhone and TV need to be on the same Wi-Fi.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPhone y tu TV deben estar en la misma red Wi-Fi."
          }
        }
      }
    },
    "Your name on the launcher": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre en el launcher"
          }
        }
      }
    },
    "arrow.down.app": {},
    "photo": {},
    "Could not read the look. %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el estilo. %@"
          }
        }
      }
    },
    "Could not load that photo. If it is in iCloud, open it in Photos first and try again.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar esa foto. Si está en iCloud, ábrela primero en Fotos e inténtalo de nuevo."
          }
        }
      }
    }
  },
  "version": "1.0"
}