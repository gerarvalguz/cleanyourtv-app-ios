{
  "sourceLanguage": "en",
  "strings": {
    "%@ look": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estilo %@"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld"
          }
        }
      }
    },
    "%@. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@. %2$@"
          }
        }
      }
    },
    "%lld": {},
    "%lld ADB services found": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld servicios ADB encontrados"
          }
        }
      }
    },
    "%lld installed · %lld currently disabled": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld instalados · %lld desactivados actualmente"
          }
        }
      }
    },
    "%lld of %lld packages selected": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld paquetes seleccionados"
          }
        }
      }
    },
    "%lld service packages detected": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld paquetes de servicio detectados"
          }
        }
      }
    },
    "1 ADB service found": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "1 servicio ADB encontrado"
          }
        }
      }
    },
    "192.168.1.42": {},
    "1:02": {},
    "A big banner of the app you are on, like newer smart TVs.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banner grande de la app en la que estás, como en los smart TV más nuevos."
          }
        }
      }
    },
    "A careful plan for your TV.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plan cuidadoso para tu TV."
          }
        }
      }
    },
    "A dark dock, a big name and a soft glow.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dock oscuro, un nombre grande y un brillo suave."
          }
        }
      }
    },
    "A frosted dock and light in each app's colour.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dock esmerilado y luz del color de cada app."
          }
        }
      }
    },
    "A read-only command failed on the TV (exit %lld).": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló un comando de solo lectura en la TV (código de salida %lld)."
          }
        }
      }
    },
    "A restore point records each package's original state first.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto de restauración guarda primero el estado original de cada paquete."
          }
        }
      }
    },
    "A restore point will be saved first. Selected packages will be disabled for user 0, not uninstalled. Restore requires this iPhone and its saved restore point.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se guardará un punto de restauración. Los paquetes seleccionados se desactivarán para el usuario 0, no se desinstalarán. Para restaurar se necesita este iPhone y su punto de restauración guardado."
          }
        }
      }
    },
    "A review plan is unavailable until all required safety checks pass.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un plan de revisión disponible hasta que se aprueben todas las verificaciones de seguridad necesarias."
          }
        }
      }
    },
    "ADB DEVICES": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "DISPOSITIVOS ADB"
          }
        }
      }
    },
    "ADB connection failed: %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la conexión ADB: %@"
          }
        }
      }
    },
    "APPS IN A ROW": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "APPS POR FILA"
          }
        }
      }
    },
    "Active keyboard": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclado activo"
          }
        }
      }
    },
    "Add %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar %@"
          }
        }
      }
    },
    "All apps": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las apps"
          }
        }
      }
    },
    "Already off": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya desactivado"
          }
        }
      }
    },
    "Amazon's home screen is back. The launcher and the Home button service were removed.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de inicio de Amazon volvió. Se eliminaron el launcher y el servicio del botón Home."
          }
        }
      }
    },
    "Analyze TV safely · read-only": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizar la TV de forma segura · solo lectura"
          }
        }
      }
    },
    "Analyze the TV before applying this plan.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza la TV antes de aplicar este plan."
          }
        }
      }
    },
    "Analyze the TV before creating a review plan.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza la TV antes de crear un plan de revisión."
          }
        }
      }
    },
    "Application stopped. The restore point was kept so you can restore the original package states. %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación se detuvo. Se conservó el punto de restauración para que puedas restaurar el estado original de los paquetes. %@"
          }
        }
      }
    },
    "Apply %lld selected package(s)": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar a %lld paquete(s) seleccionado(s)"
          }
        }
      }
    },
    "Apply selected changes": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar los cambios seleccionados"
          }
        }
      }
    },
    "Apply selected package changes?": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Aplicar los cambios a los paquetes seleccionados?"
          }
        }
      }
    },
    "Applying disables selected candidates for user 0. The saved restore point stays on this iPhone; do not delete the app before restoring.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Al aplicar se desactivan los candidatos seleccionados para el usuario 0. El punto de restauración guardado permanece en este iPhone; no borres la app antes de restaurar."
          }
        }
      }
    },
    "Applying selected packages…": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicando los paquetes seleccionados…"
          }
        }
      }
    },
    "Applying the selected package changes.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicando los cambios a los paquetes seleccionados."
          }
        }
      }
    },
    "Approve the debugging prompt on your TV. The key fingerprint is shown below.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba el aviso de depuración en tu TV. La huella de la clave se muestra abajo."
          }
        }
      }
    },
    "Approve this iPhone on your TV": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriza este iPhone en tu TV"
          }
        }
      }
    },
    "Apps first on the launcher": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps primero en el launcher"
          }
        }
      }
    },
    "Apps in a row": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps por fila"
          }
        }
      }
    },
    "BACKGROUND PICTURE": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "IMAGEN DE FONDO"
          }
        }
      }
    },
    "Bigger": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Más grandes"
          }
        }
      }
    },
    "CLEAN YOUR TV": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "CLEAN YOUR TV"
          }
        }
      }
    },
    "Calm": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Calma"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Checking TV safety details…": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisando los datos de seguridad de la TV…"
          }
        }
      }
    },
    "Choose another photo": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir otra foto"
          }
        }
      }
    },
    "Choose apps": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir apps"
          }
        }
      }
    },
    "Choose from your photos": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir de tus fotos"
          }
        }
      }
    },
    "Choose how the launcher looks and, if you want, a background photo. Your app order and the rest of the launcher's settings are kept.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo se ve el launcher y, si quieres, una foto de fondo. Se conservan el orden de tus apps y el resto de los ajustes del launcher."
          }
        }
      }
    },
    "Classic": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Clásico"
          }
        }
      }
    },
    "Clean Your TV": {},
    "Clean Your TV as the Home screen": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean Your TV como pantalla de inicio"
          }
        }
      }
    },
    "Confirmed package plan": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan de paquetes confirmado"
          }
        }
      }
    },
    "Connect to TV": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar a la TV"
          }
        }
      }
    },
    "Connect to the TV and analyze it first.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a la TV y analízala primero."
          }
        }
      }
    },
    "Connect to the TV first.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a la TV primero."
          }
        }
      }
    },
    "Connect to your TV": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a tu TV"
          }
        }
      }
    },
    "Connect to your TV, review the safety report, and apply only selected reversible changes.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a tu TV, revisa el informe de seguridad y aplica solo los cambios reversibles que selecciones."
          }
        }
      }
    },
    "Connected and identified": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectada e identificada"
          }
        }
      }
    },
    "Connecting asks the TV to authorize this iPhone's ADB key. Package changes are limited to a reviewed plan with a saved restore point.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Al conectar, la TV debe autorizar la clave ADB de este iPhone. Los cambios en paquetes se limitan a un plan revisado con un punto de restauración guardado."
          }
        }
      }
    },
    "Connecting to TV…": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando a la TV…"
          }
        }
      }
    },
    "Could not be verified": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar"
          }
        }
      }
    },
    "Could not create an ADB key: %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear una clave ADB: %@"
          }
        }
      }
    },
    "Could not read the ADB key from iOS Keychain (status %d).": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la clave ADB del llavero de iOS (estado %d)."
          }
        }
      }
    },
    "Could not read the layout. %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la disposición. %@"
          }
        }
      }
    },
    "Could not save the review plan: %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el plan de revisión: %@"
          }
        }
      }
    },
    "Create a reviewable plan from this analysis first.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero crea un plan revisable a partir de este análisis."
          }
        }
      }
    },
    "Create reviewable plan": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear plan revisable"
          }
        }
      }
    },
    "Current HOME app": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "App HOME actual"
          }
        }
      }
    },
    "Deselect optional packages before applying. Only safety-approved review candidates can be changed.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselecciona los paquetes opcionales antes de aplicar. Solo se pueden cambiar los candidatos a revisión aprobados por seguridad."
          }
        }
      }
    },
    "Deselect optional packages. Only review candidates can be applied.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselecciona los paquetes opcionales. Solo se pueden aplicar los candidatos a revisión."
          }
        }
      }
    },
    "Device %@ · Android API %lld · serial ending %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo %@ · API de Android %lld · serie terminada en %@"
          }
        }
      }
    },
    "Dock": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock"
          }
        }
      }
    },
    "Don't use the chosen photo": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No usar la foto elegida"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        }
      }
    },
    "Done. Press Home on the TV remote: it now opens the Clean Your TV launcher. Back from Amazon's Settings still works.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. Presiona Home en el control remoto de la TV: ahora abre el launcher de Clean Your TV. El botón Atrás desde los Ajustes de Amazon sigue funcionando."
          }
        }
      }
    },
    "Done. The greeting has no name now.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. El saludo ya no lleva nombre."
          }
        }
      }
    },
    "Done. The launcher greets you by name.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. El launcher te saluda por tu nombre."
          }
        }
      }
    },
    "Done. The launcher restarted with the %@ look and your picture.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. El launcher se reinició con el estilo %@ y tu imagen."
          }
        }
      }
    },
    "Done. The launcher restarted with the %@ look.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. El launcher se reinició con el estilo %@."
          }
        }
      }
    },
    "Done. The launcher restarted with your order. Anything you set in the launcher's own settings applies until you choose Follow theme.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. El launcher se reinició con tu orden. Lo que configures en los ajustes del propio launcher se aplica hasta que elijas Seguir el tema."
          }
        }
      }
    },
    "Enter an address instead": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresar una dirección"
          }
        }
      }
    },
    "Every app in one grid, with no dock band.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las apps en una sola cuadrícula, sin franja de dock."
          }
        }
      }
    },
    "Export review summary": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar resumen de revisión"
          }
        }
      }
    },
    "Fire OS does not let another launcher own Home. This installs the Clean Your TV launcher plus a small service that opens it whenever Amazon's Home screen appears. Amazon's own home stays installed and Settings still open normally.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire OS no permite que otro launcher sea el inicio. Esto instala el launcher de Clean Your TV y un pequeño servicio que lo abre cada vez que aparece la pantalla de inicio de Amazon. El inicio de Amazon sigue instalado y los Ajustes se abren con normalidad."
          }
        }
      }
    },
    "Fire TV keeps Amazon's home screen. This plan cannot remove or rearrange its rows.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire TV conserva la pantalla de inicio de Amazon. Este plan no puede quitar ni reordenar sus filas."
          }
        }
      }
    },
    "Found on your local network. Authorization is still required.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado en tu red local. Aún se requiere autorización."
          }
        }
      }
    },
    "GOOD NIGHT": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "BUENAS NOCHES"
          }
        }
      }
    },
    "GOOD NIGHT, %@": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "BUENAS NOCHES, %@"
          }
        }
      }
    },
    "Give Home back to Amazon": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Devolver el inicio a Amazon"
          }
        }
      }
    },
    "Give Home back?": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Devolver el inicio?"
          }
        }
      }
    },
    "Giving Home back to Amazon.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Devolviendo el inicio a Amazon."
          }
        }
      }
    },
    "Glass": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cristal"
          }
        }
      }
    },
    "Gray switches marked Optional are locked. Only Review candidate packages can be selected.": {
      "localizations": {
        "es-419": {
