@@ -0,0 +1,72 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONException;
+import org.junit.Test;
+
+public class WeatherTest {
+    // Open-Meteo's answer for the request Weather.url builds, trimmed to the fields read.
+    private static final String ANSWER = "{\"latitude\":14.9,\"current\":{\"time\":\"2026-10-27T15:30\","
+            + "\"temperature_2m\":29.6,\"weather_code\":3,\"is_day\":0},"
+            + "\"daily\":{\"temperature_2m_max\":[33.2],\"temperature_2m_min\":[21.5]}}";
+
+    @Test
+    public void readsTheCurrentAndTheDay() throws JSONException {
+        Weather.Now w = Weather.parse(ANSWER);
+        assertEquals(30, w.temp);
+        assertEquals(33, w.high);
+        assertEquals(22, w.low);
+        assertEquals(3, w.code);
+        assertFalse(w.day);
+    }
+
+    @Test(expected = JSONException.class)
+    public void anAnswerWithoutTheDayIsRefused() throws JSONException {
+        Weather.parse("{\"current\":{\"temperature_2m\":20,\"weather_code\":0}}");
+    }
+
+    @Test
+    public void onlyRealCoordinatesAreAsked() {
+        assertTrue(Weather.valid(14.9, -92.26));
+        assertTrue(Weather.valid(-90, 180));
+        assertFalse(Weather.valid(Double.NaN, -92.26));
+        assertFalse(Weather.valid(91, 0));
+        assertFalse(Weather.valid(0, -181));
+    }
+
+    @Test
+    public void theRequestCarriesOnlyThePlaceInAFixedFormat() {
+        assertEquals("https://api.open-meteo.com/v1/forecast?latitude=14.9000&longitude=-92.2600"
+                + "&current=temperature_2m,weather_code,is_day&daily=temperature_2m_max,temperature_2m_min"
+                + "&forecast_days=1&timezone=auto", Weather.url(14.9, -92.26));
+    }
+
+    @Test
+    public void codesBecomeWords() {
+        assertEquals(R.string.weather_clear, Weather.conditionRes(0));
+        assertEquals(R.string.weather_partly, Weather.conditionRes(2));
+        assertEquals(R.string.weather_cloudy, Weather.conditionRes(3));
+        assertEquals(R.string.weather_fog, Weather.conditionRes(48));
+        assertEquals(R.string.weather_drizzle, Weather.conditionRes(53));
+        assertEquals(R.string.weather_rain, Weather.conditionRes(63));
+        assertEquals(R.string.weather_snow, Weather.conditionRes(75));
+        assertEquals(R.string.weather_showers, Weather.conditionRes(81));
+        assertEquals(R.string.weather_storm, Weather.conditionRes(96));
+        assertEquals(R.string.weather_cloudy, Weather.conditionRes(-1));
+    }
+
+    @Test
+    public void anAnswerIsShownForSixHoursAndAskedAgainAfterThirtyMinutes() {
+        Weather.Now w = new Weather.Now(30, 33, 22, 0, true);
+        Weather.store(w, 1_000_000L);
+        assertNotNull(Weather.shown(1_000_000L + Weather.STALE_MS));
+        assertNull(Weather.shown(1_000_000L + Weather.STALE_MS + 1));
+        assertFalse(Weather.due(1_000_000L + Weather.REFRESH_MS - 1));
+        assertTrue(Weather.due(1_000_000L + Weather.REFRESH_MS));
+    }
+}
