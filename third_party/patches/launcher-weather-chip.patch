+    // ---- weather chip (weather_lat and weather_lon) --------------------------------------------------
+
+    /**
+     * Shows the last answer, and asks again when it is 30 minutes old: on Home's resume only, on a worker
+     * thread, never on a timer. A failed ask leaves the chip as it was and is tried again at the next resume.
+     */
+    private void refreshWeather() {
+        if (!Weather.valid(weatherLat, weatherLon)) return;
+        showWeather();
+        long now = System.currentTimeMillis();
+        if (weatherFetching || !Weather.due(now)) return;
+        weatherFetching = true;
+        final double lat = weatherLat, lon = weatherLon;
+        new Thread(() -> {
+            Weather.Now result = null;
+            try {
+                result = Weather.fetch(lat, lon);
+            } catch (IOException | org.json.JSONException | RuntimeException e) {
+                // offline, a bad answer or a server error: nothing to show, and the next resume asks again
+            }
+            final Weather.Now answer = result;
+            runOnUiThread(() -> {
+                weatherFetching = false;
+                if (answer != null) Weather.store(answer, System.currentTimeMillis());
+                if (!isFinishing() && !isDestroyed()) showWeather();
+            });
+        }, "weather").start();
+    }
+
+    /**
+     * The chip needs room: the dock and the rows under it start about 168 dp down with two rows under the dock
+     * and would sit on it, so it shows only with at most one row under the dock (the cinematic shelf has none),
+     * and not while the race-weekend panel takes the same place.
+     */
+    private void showWeather() {
+        Weather.Now w = Weather.shown(System.currentTimeMillis());
+        boolean room = rowsUnderDock <= 1 && racePanel.getVisibility() != View.VISIBLE;
+        if (w == null || !room) {
+            weatherChip.setVisibility(View.GONE);
+            return;
+        }
+        weatherIcon.setImageResource(w.day ? R.drawable.ic_weather_sun : R.drawable.ic_weather_moon);
+        weatherTemp.setText(getString(R.string.weather_degrees, w.temp));
+        weatherCondition.setText(Weather.conditionRes(w.code));
+        weatherRange.setText(getString(R.string.weather_range, w.high, w.low));
+        weatherChip.setVisibility(View.VISIBLE);
+    }
+
     // ---- race-weekend panel (a theme's race_calendar) -----------------------------------------------
 
     private static final int RACE_RED = 0xFFFF3B2F;
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/Weather.java b/launcher/app/src/main/java/com/gathin/tvhome/Weather.java
new file mode 100644
index 00000000..8fb35690
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/Weather.java
@@ -0,0 +1,116 @@
+package com.gathin.tvhome;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+
+/**
+ * The weather chip under the clock (config weather_lat and weather_lon, both needed; off without them).
+ * One GET to Open-Meteo (https://open-meteo.com, no account or key) when Home is shown and the last answer
+ * is 30 minutes old: no timer, no service, nothing runs while another app is open. Only the coordinates
+ * the owner chose are sent. Celsius.
+ * shortcut: Celsius only, no unit key; add weather_unit if someone asks for Fahrenheit.
+ */
+final class Weather {
+    static final long REFRESH_MS = 30 * 60 * 1000L;
+    /** An answer older than this is not shown (the TV was offline for hours). */
+    static final long STALE_MS = 6 * 60 * 60 * 1000L;
+    private static final int MAX_BYTES = 16 * 1024;
+
+    static final class Now {
+        final int temp, high, low, code;
+        final boolean day;
+
+        Now(int temp, int high, int low, int code, boolean day) {
+            this.temp = temp;
+            this.high = high;
+            this.low = low;
+            this.code = code;
+            this.day = day;
+        }
+    }
+
+    private static volatile Now last;
+    private static volatile long lastAt;
+
+    private Weather() {}
+
+    static boolean valid(double lat, double lon) {
+        return lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180;   // false for NaN too
+    }
+
+    static String url(double lat, double lon) {
+        return String.format(Locale.US, "https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f"
+                + "&current=temperature_2m,weather_code,is_day&daily=temperature_2m_max,temperature_2m_min"
+                + "&forecast_days=1&timezone=auto", lat, lon);
+    }
+
+    static Now parse(String json) throws JSONException {
+        JSONObject root = new JSONObject(json);
+        JSONObject current = root.getJSONObject("current");
+        JSONObject daily = root.getJSONObject("daily");
+        JSONArray max = daily.getJSONArray("temperature_2m_max");
+        JSONArray min = daily.getJSONArray("temperature_2m_min");
+        return new Now((int) Math.round(current.getDouble("temperature_2m")),
+                (int) Math.round(max.getDouble(0)), (int) Math.round(min.getDouble(0)),
+                current.getInt("weather_code"), current.optInt("is_day", 1) != 0);
+    }
+
+    /** The words for a WMO weather code (Open-Meteo's weather_code). */
+    static int conditionRes(int code) {
+        if (code == 0) return R.string.weather_clear;
+        if (code == 1 || code == 2) return R.string.weather_partly;
+        if (code == 3) return R.string.weather_cloudy;
+        if (code == 45 || code == 48) return R.string.weather_fog;
+        if (code >= 51 && code <= 57) return R.string.weather_drizzle;
+        if (code >= 61 && code <= 67) return R.string.weather_rain;
+        if ((code >= 71 && code <= 77) || code == 85 || code == 86) return R.string.weather_snow;
+        if (code >= 80 && code <= 82) return R.string.weather_showers;
+        if (code >= 95) return R.string.weather_storm;
+        return R.string.weather_cloudy;
+    }
+
+    static Now fetch(double lat, double lon) throws IOException, JSONException {
+        HttpURLConnection c = (HttpURLConnection) new URL(url(lat, lon)).openConnection();
+        try {
+            c.setConnectTimeout(8000);
+            c.setReadTimeout(8000);
+            c.setRequestProperty("Accept", "application/json");
+            if (c.getResponseCode() != 200) throw new IOException("HTTP " + c.getResponseCode());
+            try (InputStream in = c.getInputStream()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buf = new byte[2048];
+                int n;
+                while ((n = in.read(buf)) > 0) {
+                    out.write(buf, 0, n);
+                    if (out.size() > MAX_BYTES) throw new IOException("answer too long");
+                }
+                return parse(new String(out.toByteArray(), StandardCharsets.UTF_8));
+            }
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    static void store(Now now, long at) {
+        last = now;
+        lastAt = at;
+    }
+
+    /** The last answer, or null when there is none or it is too old to show. */
+    static Now shown(long at) {
+        return last != null && at - lastAt <= STALE_MS ? last : null;
+    }
+
+    static boolean due(long at) {
+        return at - lastAt >= REFRESH_MS;
+    }
+}
